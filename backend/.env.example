# Required. Use a long random secret — the app refuses weak/default keys.
# Generate (bash):  openssl rand -hex 32
# Generate (PowerShell):
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
ADMIN_KEY=replace-with-a-long-random-secret

# Origins allowed by CORS (scheme + host only, no path). For GitHub Pages production:
#   CORS_ORIGINS=https://valeru19.github.io
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:4173,http://localhost:4173

DATABASE_URL=sqlite:///./data/portfolio.db
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=10

# TRUST_PROXY=true only when the API sits behind Caddy (or another trusted reverse
# proxy that sets X-Forwarded-For). On VPS the API is not published to the host —
# clients reach it only through Caddy — so set TRUST_PROXY=true there.
TRUST_PROXY=false
